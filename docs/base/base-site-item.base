filters:
  and:
    - file.inFolder("site/site-item")
    - file.ext == "md"
    - or:
        - this.file.ext == "base"
        - file.hasLink(this.file)
formulas:
  iconembed: image(icon)
views:
  - type: cards
    name: cardsmini
    order: []
    image: note.icon
    cardSize: 80
  - type: cards
    name: cardsmini/categories
    groupBy:
      property: categories
      direction: ASC
    order: []
    sort: []
    image: note.icon
    cardSize: 80
  - type: cards
    name: Cards
    order:
      - title
    image: note.icon
  - type: table
    name: Table
    order:
      - categories
      - file.name
      - title-slugified
      - formula.iconembed
      - title
      - url
      - description
    columnSize:
      note.categories: 255
      file.name: 14
      formula.iconembed: 47
      note.title: 98
      note.url: 250
